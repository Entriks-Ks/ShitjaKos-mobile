# Optional. Leave unset to auto-detect the web app on your computer
# (LAN IP:3001, or Android emulator 10.0.2.2:3001).
# On Expo web, the app talks to itself and proxies /api/auth to this URL.
# EXPO_PUBLIC_API_URL="http://localhost:3001"

# Must match BETTER_AUTH_URL origin on the web server (CSRF / Origin check).
# EXPO_PUBLIC_AUTH_ORIGIN="http://localhost:3001"
